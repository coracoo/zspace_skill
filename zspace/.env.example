# ZSpace NAS 连接
NAS_HOST="你的极空间 IP"
NAS_USER="你的极空间手机号"
NAS_PASSWORD="你的极空间密码"

# 设备 ID(可选,32 字符十六进制。留空自动从机器指纹生成并持久化,首次短信验证后自动复用)
NAS_DEVICE_ID=

# SSH 凭据(可选,仅 perf_snapshot 性能监控需要)
KEY_SSH="你的极空间 SSH 密码"
NAS_SSH_PORT="57922"

# RAG 语义搜索(可选,需先部署 nas-rag-server docker)
NAS_RAG_URL="http://你的极空间IP:8000"
NAS_RAG_PATH_MAP="/nas_data/→/sata14/my/data/你的目录/"

# iPhone 备忘录同步(可选,ios-memo-bak skill 自动生成)
SHORTCUT_KEY=""

# MCP HTTP transport(./start.sh mcp-http)
# 留空 → 首次启动自动生成,打印到 stderr,粘到这里可钉死复用
# MCP_HTTP_TOKEN=
