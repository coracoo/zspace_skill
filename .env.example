# ZSpace NAS 凭据(由 start.sh 加载)
# 复制为 .env 后填入真实值;.env 已在 .gitignore,不会进 git
#
# 注意:本文件由 shell `source` 加载,值含空格或特殊字符(# $ " ' 等)时
# 必须用双引号包裹,例如 NAS_HOST="192.168 0.135"

NAS_HOST="你的极空间 IP"
NAS_USER="你的极空间 NAS 用户"
NAS_PASSWORD="你的极空间 NAS 密码"
NAS_DEVICE_ID="你的极空间设备 ID"
KEY_SSH="你的极空间 SSH 密码"
NAS_SSH_PORT="你的极空间 SSH 端口"
